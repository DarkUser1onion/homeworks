<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background: #f5f6fa; color: #222; }
        header { background: #2c3e50; color: #fff; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; }
        header .logo { font-weight: bold; font-size: 1.2em; }
        header nav a { color: #fff; margin-left: 16px; text-decoration: none; }
        main { max-width: 1200px; margin: 24px auto; padding: 0 16px; }
        footer { text-align: center; padding: 16px; color: #777; border-top: 1px solid #ddd; margin-top: 40px; }
        .page-header { margin-bottom: 20px; }
        .page-header h1 { margin: 0 0 6px; }
        .page-header .subtitle { color: #666; }
        .card { background: #fff; border-radius: 8px; padding: 16px; margin: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
        .card h4 { margin: 0 0 8px; }
        .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.8em; background: #eee; margin-left: 8px; }
        .badge.negative { background: #f8d7da; color: #721c24; }
        .badge.low      { background: #e2f0d9; color: #2e7d32; }
        .badge.mid      { background: #fff3cd; color: #856404; }
        .badge.high     { background: #d1ecf1; color: #0c5460; }
        .value { font-size: 1.4em; font-weight: bold; }
        .trend-up { color: #2e7d32; }
        .trend-down { color: #c62828; }
        .trend-stable { color: #666; }
        .cards-grid { display: flex; flex-wrap: wrap; }
        .cards-grid .card { flex: 1 1 30%; min-width: 260px; }
        .actions { margin-top: 12px; }
        .actions a { display: inline-block; padding: 8px 16px; background: #2c3e50; color: #fff; text-decoration: none; border-radius: 4px; }
    </style>
</head>
<body>
    <header>
        <div class="logo">Админ-панель</div>
        <nav>
            <a href="/Dashboard">Дашборд</a>
            <a href="/Settings">Настройки</a>
        </nav>
    </header>

    <main>
        @if (IsSectionDefined("PageHeader"))
        {
            @await RenderSectionAsync("PageHeader", required: false)
        }
        else
        {
            <div class="page-header"><h1>Панель управления</h1></div>
        }

        @RenderBody()
    </main>

    <footer>
        © @DateTime.Now.Year Админ-панель
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>