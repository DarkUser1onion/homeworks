@model List<ShopCatalog.Models.CartItem>
@{
    ViewData["Title"] = "Корзина";
}

<div class="container my-4">
    <h1 class="page-title">Корзина</h1>

    @* Alert: "Товар добавлен" — показывается один раз после добавления *@
    @if (TempData["Added"] is string addedName)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
                Товар «@addedName» добавлен в корзину.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        @* Alert: пустая корзина *@
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                Корзина пуста. Перейдите в <a asp-controller="Catalog" asp-action="Index" class="alert-link">каталог</a>, чтобы добавить товары.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
        </div>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Товар</th>
                    <th class="text-end">Цена</th>
                    <th class="text-center">Кол-во</th>
                    <th class="text-end">Сумма</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td class="text-end">@item.Price.ToString("N0") ₽</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@((item.Price * item.Quantity).ToString("N0")) ₽</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Итого:</th>
                    <th class="text-end">@Model.Sum(i => i.Price * i.Quantity).ToString("N0") ₽</th>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex gap-2 mt-3">
        <button type="button"
                class="btn btn-checkout btn-lg"
                data-bs-toggle="modal"
                data-bs-target="#confirmOrderModal">
            Оформить заказ
        </button>

            <form asp-controller="Cart" asp-action="Clear" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary">Очистить корзину</button>
            </form>
        </div>

        @* Модальное окно подтверждения *@
        <div class="modal fade" id="confirmOrderModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Подтверждение заказа</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>

                    <div class="modal-body">
                        <p>
                            Вы уверены, что хотите оформить заказ на сумму
                            <strong>@Model.Sum(i => i.Price * i.Quantity).ToString("N0") ₽</strong>?
                        </p>

                        <ul class="list-group mb-3">
                            @foreach (var item in Model)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@item.Name × @item.Quantity</span>
                                    <span class="text-muted">@((item.Price * item.Quantity).ToString("N0")) ₽</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <form asp-controller="Cart" asp-action="Checkout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-checkout">Подтвердить</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>