@model TaskBoard.Services.TaskItem
@{
    ViewData["Title"] = "Детали задачи";
}

<h1>@Model.Title</h1>
<p><strong>Статус:</strong> @(Model.IsDone ? "Готово" : "В работе")</p>
<p><strong>Описание:</strong> @(Model.Description ?? "—")</p>
<p><strong>Создана:</strong> @Model.CreatedAt</p>
<a href="/tasks" class="btn btn-secondary">Назад</a>